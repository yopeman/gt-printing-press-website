# MongoDB Connection URI (Local or MongoDB Atlas)
MONGODB_URI=

# Security & Admin Session Management
ADMIN_JWT_SECRET=
ADMIN_DEFAULT_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# Public Site Domain
NEXT_PUBLIC_SITE_URL=

# Node Environment
NODE_ENV=production

# Cloudinary Storage (Optional - automatically falls back to local /public/uploads if not provided)
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# or specify the 3 credentials individually:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
